---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryTree from '../../components/CategoryTree.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 우측 사이드바용 집계
const categoryCounts = new Map<string, number>();
for (const post of posts) {
	const c = post.data.category;
	categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
}
const sortedCategories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="작성한 모든 글의 목록입니다." />
		<style>
			/* 3단 그리드 뼈대 (index.astro / BlogPost.astro와 동일 규격) */
			.wiki-container {
				display: grid;
				grid-template-columns: 200px 1fr 180px;
				gap: 1.2rem;
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem 1rem;
				width: 100%;
			}

			.sidebar-left {
				grid-column: 1;
				border-right: 1px solid rgba(0, 0, 0, 0.06);
				padding-right: 1.2rem;
			}

			main {
				grid-column: 2;
				min-width: 0;
			}

			.sidebar-right {
				grid-column: 3;
				border-left: 1px solid rgba(0, 0, 0, 0.06);
				padding-left: 1.2rem;
			}

			/* 페이지 머리말 */
			.list-hero {
				margin-bottom: 2rem;
				padding: 0.5rem 0 1.5rem 0;
				border-bottom: 1px solid rgba(0, 0, 0, 0.06);
			}

			.list-hero h1 {
				margin: 0 0 0.4rem 0;
				font-size: 1.6rem;
				letter-spacing: -0.03em;
				font-weight: 800;
				color: rgb(var(--black));
			}

			.list-hero p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
			}

			/* 글 목록 카드 */
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.post-card {
				background: #ffffff;
				border: 1px solid rgba(0, 0, 0, 0.05);
				border-radius: var(--border-radius);
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
				overflow: hidden;
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}

			.post-card:hover {
				box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.08);
				transform: translateY(-2px);
			}

			.post-card-link {
				display: flex;
				gap: 1.2rem;
				padding: 1.2rem;
				text-decoration: none;
				color: inherit;
				align-items: flex-start;
			}

			.post-thumb {
				width: 160px;
				height: 90px;
				object-fit: cover;
				border-radius: 6px;
				flex-shrink: 0;
			}

			.post-body {
				min-width: 0;
			}

			.post-card-title {
				margin: 0 0 0.35rem 0;
				font-size: 1.05rem;
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1.4;
			}

			.post-card-link:hover .post-card-title {
				color: var(--accent);
			}

			.post-card-desc {
				margin: 0 0 0.6rem 0;
				font-size: 0.88rem;
				color: rgb(var(--gray-dark));
				line-height: 1.55;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}

			.post-tag {
				background: rgba(0, 0, 0, 0.04);
				color: rgb(var(--gray-dark));
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
			}

			.empty-state {
				background: #ffffff;
				border: 1px solid rgba(0, 0, 0, 0.05);
				border-radius: var(--border-radius);
				padding: 2rem;
				text-align: center;
				color: rgb(var(--gray));
			}

			/* 우측 사이드바 카드 (index.astro와 동일 규격) */
			.about-card {
				background: #ffffff;
				border: 1px solid rgba(0, 0, 0, 0.05);
				border-radius: var(--border-radius);
				padding: 1.2rem 1rem;
				font-size: 0.85rem;
				margin-bottom: 1rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
			}

			.about-card h3 {
				font-size: 0.95rem;
				margin-bottom: 0.6rem;
			}

			.about-card p {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}

			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.tag-badge {
				background: rgba(0, 0, 0, 0.04);
				color: rgb(var(--gray-dark));
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
				font-size: 0.75rem;
			}

			.tag-badge .count {
				color: rgb(var(--gray));
			}

			.post-category {
				background: rgba(59, 130, 246, 0.1);
				color: var(--accent-dark);
				padding: 0.1rem 0.4rem;
				border-radius: 4px;
				font-weight: 600;
			}

			.count-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.count-list li {
				display: flex;
				justify-content: space-between;
				padding: 0.25rem 0;
				color: rgb(var(--gray-dark));
			}

			.count-list .count {
				color: rgb(var(--gray));
			}

			/* 반응형 (index.astro와 동일 브레이크포인트) */
			@media (max-width: 1024px) {
				.wiki-container {
					grid-template-columns: 200px 1fr;
				}
				.sidebar-right {
					display: none;
				}
			}

			@media (max-width: 768px) {
				.wiki-container {
					grid-template-columns: 1fr;
					padding: 1rem;
				}
				.sidebar-left {
					display: none;
				}
				.post-card-link {
					flex-direction: column;
				}
				.post-thumb {
					width: 100%;
					height: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="wiki-container">
			<!-- 1. 좌측: 분류 트리 -->
			<aside class="sidebar-left">
				<CategoryTree />
			</aside>

			<!-- 2. 중앙: 글 목록 -->
			<main>
				<section class="list-hero">
					<h1>전체 글</h1>
					<p>지금까지 작성한 글 {posts.length}편을 최신순으로 정리했습니다.</p>
				</section>

				{posts.length === 0 ? (
					<div class="empty-state">아직 작성한 글이 없습니다.</div>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`} class="post-card-link">
									{post.data.heroImage && (
										<Image
											class="post-thumb"
											width={320}
											height={180}
											src={post.data.heroImage}
											alt=""
										/>
									)}
									<div class="post-body">
										<h3 class="post-card-title">{post.data.title}</h3>
										<p class="post-card-desc">{post.data.description}</p>
										<div class="post-meta">
											<span class="post-category">
												{post.data.category}
												{post.data.subcategory && ` › ${post.data.subcategory}`}
											</span>
											<FormattedDate date={post.data.pubDate} />
											{post.data.tags.map((tag) => (
												<span class="post-tag">#{tag}</span>
											))}
										</div>
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</main>

			<!-- 3. 우측: 아카이브 정보 -->
			<aside class="sidebar-right">
				<div class="about-card">
					<h3>📚 아카이브</h3>
					<p>전체 <strong>{posts.length}</strong>편</p>
				</div>
				{sortedCategories.length > 0 && (
					<div class="about-card">
						<h3>📂 분류</h3>
						<ul class="count-list">
							{sortedCategories.map(([name, count]) => (
								<li><span>{name}</span><span class="count">{count}</span></li>
							))}
						</ul>
					</div>
				)}
				{sortedTags.length > 0 && (
					<div class="about-card">
						<h3>🏷️ 태그</h3>
						<div class="tag-cloud">
							{sortedTags.map(([tag, count]) => (
								<span class="tag-badge">#{tag} <span class="count">{count}</span></span>
							))}
						</div>
					</div>
				)}
			</aside>
		</div>
		<Footer />
	</body>
</html>

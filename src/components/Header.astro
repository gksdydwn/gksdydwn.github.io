---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
---

<header>
	<nav>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<h2 class="logo"><a href="/">{SITE_TITLE}</a></h2>
		<div class="right-link">
			<Search />
			<a href="https://github.com/gksdydwn/gksdydwn.github.io" target="_blank" aria-label="GitHub Repository">
				<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 2rem;
		background: rgba(255, 255, 255, 0.85); /* 그레이 배경 위에서 더 산뜻하게 보이도록 반투명도 살짝 낮춤 */
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr; /* 정중앙 대칭 3단 그리드 */
		align-items: center;
		height: 3.5rem;
		max-width: 1200px;
		margin: 0 auto;
	}
	.logo {
		justify-self: center; /* 로고를 중앙 배치 */
		margin: 0;
	}
	.logo a {
		font-weight: 800;
		font-size: 1.1rem;
		color: rgb(var(--black));
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
		justify-self: start; /* 메뉴를 좌측 정렬 */
	}
	.internal-links :global(a) {
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		font-weight: 550;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		transition: all 0.2s ease;
	}
	.internal-links :global(a:hover) {
		color: var(--accent);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.right-link {
		justify-self: end; /* 검색·깃허브를 우측 정렬 */
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}
	.right-link a {
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		transition: color 0.2s ease;
	}
	.right-link a:hover {
		color: var(--accent);
	}
</style>

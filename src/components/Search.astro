---
import { getCollection } from 'astro:content';

// 빌드 시점에 색인을 만들어 페이지에 심는다. 서버가 없는 정적 사이트라
// 검색은 전부 브라우저에서 이 색인을 걸러내는 방식으로 처리한다.
// 본문은 넣지 않는다 — 색인이 커져 첫 로딩이 무거워지기 때문.
const posts = await getCollection('blog');
const index = posts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		t: post.data.title,
		d: post.data.description,
		c: post.data.category,
		s: post.data.subcategory ?? '',
		g: post.data.tags,
		u: `/blog/${post.id}/`,
		p: post.data.pubDate.toISOString().slice(0, 10),
	}));
---

<button class="search-trigger" type="button" aria-label="검색 열기" data-search-open>
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<circle cx="11" cy="11" r="7"></circle>
		<path d="M20 20l-3.5-3.5"></path>
	</svg>
	<kbd class="search-kbd">Ctrl K</kbd>
</button>

<div class="search-overlay" data-search-overlay hidden>
	<div class="search-panel" role="dialog" aria-modal="true" aria-label="글 검색">
		<div class="search-field">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M20 20l-3.5-3.5"></path>
			</svg>
			<input
				type="search"
				class="search-input"
				placeholder="제목, 태그, 분류로 검색 (예: astro)"
				autocomplete="off"
				spellcheck="false"
				data-search-input
			/>
			<button class="search-close" type="button" aria-label="닫기" data-search-close>Esc</button>
		</div>
		<div class="search-results" data-search-results></div>
	</div>
</div>

<script is:inline define:vars={{ index }}>
	(() => {
		const overlay = document.querySelector('[data-search-overlay]');
		const input = document.querySelector('[data-search-input]');
		const results = document.querySelector('[data-search-results]');
		if (!overlay || !input || !results) return;

		let active = -1;

		const escapeHtml = (value) =>
			String(value).replace(/[&<>"']/g, (ch) => {
				if (ch === '&') return '&amp;';
				if (ch === '<') return '&lt;';
				if (ch === '>') return '&gt;';
				if (ch === '"') return '&quot;';
				return '&#39;';
			});

		// 공백으로 나눈 낱말을 전부 포함해야 결과에 든다.
		// 각 낱말은 제목/설명/분류/소분류/태그 중 어디에 걸려도 인정한다.
		// 색인에는 태그가 '#' 없이 들어 있으므로, 사람이 '#astro'라고 쳐도 걸리도록 앞의 #을 떼어낸다.
		const search = (query) => {
			const words = query
				.toLowerCase()
				.split(/\s+/)
				.map((word) => word.replace(/^#+/, ''))
				.filter(Boolean);
			if (words.length === 0) return [];
			return index.filter((item) => {
				const haystack = [item.t, item.d, item.c, item.s, item.g.join(' ')]
					.join(' ')
					.toLowerCase();
				return words.every((word) => haystack.includes(word));
			});
		};

		const render = (items, query) => {
			active = items.length > 0 ? 0 : -1;
			if (!query) {
				results.innerHTML = '<p class="search-hint">제목, 설명, 태그, 분류에서 찾습니다.</p>';
				return;
			}
			if (items.length === 0) {
				results.innerHTML =
					'<p class="search-hint">&ldquo;' + escapeHtml(query) + '&rdquo; 에 해당하는 글이 없습니다.</p>';
				return;
			}
			const rows = items
				.map((item, i) => {
					const sub = item.s ? ' &rsaquo; ' + escapeHtml(item.s) : '';
					const tags = item.g
						.map((tag) => '<span class="search-tag">#' + escapeHtml(tag) + '</span>')
						.join('');
					return (
						'<li><a class="search-item' +
						(i === 0 ? ' active' : '') +
						'" href="' +
						item.u +
						'">' +
						'<span class="search-item-title">' +
						escapeHtml(item.t) +
						'</span>' +
						'<span class="search-item-meta">' +
						escapeHtml(item.c) +
						sub +
						' &middot; ' +
						escapeHtml(item.p) +
						'</span>' +
						'<span class="search-item-tags">' +
						tags +
						'</span>' +
						'</a></li>'
					);
				})
				.join('');
			results.innerHTML =
				'<p class="search-count">' + items.length + '건</p><ul class="search-list">' + rows + '</ul>';
		};

		const move = (delta) => {
			const items = results.querySelectorAll('.search-item');
			if (items.length === 0) return;
			if (items[active]) items[active].classList.remove('active');
			active = (active + delta + items.length) % items.length;
			items[active].classList.add('active');
			items[active].scrollIntoView({ block: 'nearest' });
		};

		const open = () => {
			overlay.hidden = false;
			document.body.style.overflow = 'hidden';
			input.value = '';
			render([], '');
			input.focus();
		};

		const close = () => {
			overlay.hidden = true;
			document.body.style.overflow = '';
		};

		document.querySelectorAll('[data-search-open]').forEach((btn) => btn.addEventListener('click', open));
		document.querySelectorAll('[data-search-close]').forEach((btn) => btn.addEventListener('click', close));

		// 패널 바깥(어두운 배경)을 누르면 닫는다.
		overlay.addEventListener('click', (event) => {
			if (event.target === overlay) close();
		});

		input.addEventListener('input', () => {
			const query = input.value.trim();
			render(search(query), query);
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				move(1);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				move(-1);
			} else if (event.key === 'Enter') {
				const items = results.querySelectorAll('.search-item');
				if (items[active]) {
					event.preventDefault();
					window.location.href = items[active].getAttribute('href');
				}
			}
		});

		document.addEventListener('keydown', (event) => {
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				if (overlay.hidden) {
					open();
				} else {
					close();
				}
			} else if (event.key === 'Escape' && !overlay.hidden) {
				close();
			}
		});
	})();
</script>

<style>
	.search-trigger {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: rgba(0, 0, 0, 0.03);
		border: 1px solid rgba(0, 0, 0, 0.07);
		border-radius: 6px;
		padding: 0.3rem 0.5rem;
		color: rgb(var(--gray));
		cursor: pointer;
		font: inherit;
		transition: all 0.15s ease;
	}
	.search-trigger:hover {
		background: rgba(0, 0, 0, 0.06);
		color: rgb(var(--black));
	}

	.search-kbd {
		font-size: 0.7rem;
		font-family: inherit;
		color: rgb(var(--gray));
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: 4px;
		padding: 0 0.25rem;
		background: #fff;
	}
	@media (max-width: 640px) {
		.search-kbd {
			display: none;
		}
	}

	.search-overlay {
		position: fixed;
		inset: 0;
		background: rgba(15, 23, 42, 0.35);
		backdrop-filter: blur(2px);
		z-index: 200;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: 10vh 1rem 1rem;
	}
	.search-overlay[hidden] {
		display: none;
	}

	.search-panel {
		width: 100%;
		max-width: 560px;
		background: #ffffff;
		border-radius: var(--border-radius);
		box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.25);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: 70vh;
	}

	.search-field {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.07);
		color: rgb(var(--gray));
	}

	.search-input {
		flex: 1;
		border: none;
		outline: none;
		font: inherit;
		font-size: 1rem;
		color: rgb(var(--black));
		background: transparent;
		min-width: 0;
	}
	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	.search-close {
		border: 1px solid rgba(0, 0, 0, 0.1);
		background: rgba(0, 0, 0, 0.03);
		border-radius: 4px;
		padding: 0.1rem 0.4rem;
		font: inherit;
		font-size: 0.72rem;
		color: rgb(var(--gray));
		cursor: pointer;
		flex-shrink: 0;
	}

	.search-results {
		overflow-y: auto;
		padding: 0.5rem;
	}

	/* 아래 요소들은 검색할 때마다 JS가 innerHTML로 새로 만들어낸다.
	   Astro의 scoped CSS는 빌드 시점에 템플릿 요소에만 data-astro-cid-* 를 붙이므로,
	   런타임에 생긴 요소에는 적용되지 않는다. 그래서 :global()로 열어 둔다.
	   범위가 새지 않도록 정적 요소인 .search-results 안쪽으로 한정한다. */
	.search-results :global(.search-hint),
	.search-results :global(.search-count) {
		margin: 0;
		padding: 0.6rem 0.7rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}

	.search-results :global(.search-list) {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.search-results :global(.search-list li) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.search-results :global(.search-item) {
		display: block;
		padding: 0.6rem 0.7rem;
		border-radius: 6px;
		text-decoration: none;
		color: inherit;
	}
	.search-results :global(.search-item:hover),
	.search-results :global(.search-item.active) {
		background: rgba(59, 130, 246, 0.09);
	}

	.search-results :global(.search-item-title) {
		display: block;
		font-weight: 600;
		font-size: 0.92rem;
		color: rgb(var(--black));
		margin-bottom: 0.15rem;
	}

	.search-results :global(.search-item-meta) {
		display: block;
		font-size: 0.75rem;
		color: rgb(var(--gray));
	}

	.search-results :global(.search-item-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin-top: 0.3rem;
	}

	.search-results :global(.search-tag) {
		font-size: 0.7rem;
		background: rgba(0, 0, 0, 0.04);
		color: rgb(var(--gray-dark));
		padding: 0.05rem 0.35rem;
		border-radius: 4px;
	}
</style>
